{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "noEmit": true
  },
  "include": [
    "server.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "prisma.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "scratch",
    "test-results"
  ]
}
