        {
          "name": "kognitika-core",
          "databaseUrlAccess": "forbidden",
          "ddlMigrations": "forbidden",
          "writes": "forbidden"
        },
        {
          "name": "future-axum-analytics-sidecar",
          "databaseUrlAccess": "forbidden",
          "ddlMigrations": "forbidden",
          "writes": "forbidden"
        }
      ],
      "rollback": {
        "restoresNodePrismaAuthority": true
      }
    },
    {
      "id": "bounded-rust-write-owner",
      "status": "not-authorized-without-separate-transfer-pr",
      "ddlOwner": "prisma",
