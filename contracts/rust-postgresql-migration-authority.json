  "readerSchemaContract": {
    "nullableFieldsDocumented": true,
    "enumValuesVersioned": true,
    "requiredIndexesDocumented": true,
    "foreignKeysDocumented": true,
    "idempotencyKeysDocumented": true,
    "transactionBoundariesDocumented": true
  },
