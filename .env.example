# Never commit real secrets. Copy this file to .env for local development.

# DATABASE_URL: PostgreSQL connection string required for Prisma
DATABASE_URL="postgresql://admin:adminpassword@localhost:5432/cognitika?schema=public"

# JWT_SECRET: Secret for signing JWT authentication tokens
JWT_SECRET="replace-with-strong-random-secret"

# Admin notification mailbox. This is not a public identity or auth source.
ADMIN_NOTIFICATION_EMAIL="admin@example.com"

# Legacy email channels are opt-in only; Brain ID public users do not require email.
LEGACY_EMAIL_NOTIFICATIONS_ENABLED="false"
LEGACY_EMAIL_AUTH_ENABLED="false"

# App URLs
APP_URL="http://localhost:3006"
FRONTEND_URL="http://localhost:3006"

# Telegram Config
TELEGRAM_BOT_TOKEN="replace-me"
TELEGRAM_ADMIN_CHAT_ID="replace-me"

# SMTP Config (Email)
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="user@example.com"
SMTP_PASS="replace-me"

# Server Config
PORT=3006
CORS_ORIGIN="http://localhost:3006"
# Set both values only for local/test wildcard CORS. Production must use an explicit CORS_ORIGIN allowlist.
CORS_ALLOW_DEV_WILDCARD="false"
# Capacitor uses fixed local WebView origins while calling the production API.
CORS_ALLOW_NATIVE_APP="true"

# Debug logging — set to "true" for verbose server-side logging
DEBUG_LOGS="false"

# Optional server-only OpenAI-compatible neurotrainer provider.
# Disabled mode always uses deterministic local generation and analysis.
LLM_ENABLED="false"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY="replace-me"
LLM_MODEL="replace-with-model-name"
LLM_TIMEOUT_MS="8000"

# Vite build variables — set during CI/CD build step
VITE_BUILD_ID="dev"
VITE_GIT_COMMIT="dev"
VITE_DEBUG_LOGS="false"

# Docker / runtime
NODE_ENV="development"
