# Kognitika - Environment Variables
# Copy to .env and fill in values

# ============================================================
# REQUIRED - Application will fail to start without these
# ============================================================

# JWT Secret for authentication tokens (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Database connection (PostgreSQL)
# Format: ************************************/database?schema=public
DATABASE_URL=**********************************************/kognitika?schema=public

# Docker Compose database credentials (required by docker-compose.yml)
POSTGRES_USER=kognitika
POSTGRES_PASSWORD=replace-with-strong-random-password
POSTGRES_DB=kognitika

# ============================================================
# SERVER CONFIGURATION
# ============================================================

# Server port (default: 3006)
PORT=3006

# Node environment (development|production)
NODE_ENV=development

# Production defaults to loopback. Containers must explicitly use 0.0.0.0.
LISTEN_HOST=0.0.0.0

# Trust only the local reverse proxy, never use an unrestricted true value.
TRUST_PROXY=loopback

# Concurrent SSE stream limits.
SSE_MAX_CONNECTIONS=200
SSE_MAX_CONNECTIONS_PER_ADDRESS=5

# Socket.io and duel capacity limits.
SOCKET_MAX_CONNECTIONS=500
SOCKET_MAX_CONNECTIONS_PER_USER=3
SOCKET_MAX_EVENTS_PER_SECOND=30
DUEL_MAX_QUEUE_SIZE=500
DUEL_MAX_ACTIVE=250

# Build identifier (auto-set in CI/CD)
# BUILD_HASH=
# GIT_COMMIT=

# ============================================================
# CORS CONFIGURATION
# ============================================================

# Comma-separated list of allowed origins
# Production: must be explicit (no wildcards)
# Development: can use wildcard with CORS_ALLOW_DEV_WILDCARD=true
CORS_ORIGIN=https://kognitika.ru,http://localhost:3006,http://127.0.0.1:3006

# Allow wildcard (*) in development only
# DANGEROUS in production - requires explicit opt-in
CORS_ALLOW_DEV_WILDCARD=false

# ============================================================
# RATE LIMITING
# ============================================================

# API rate limit window (ms)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window
RATE_LIMIT_MAX=100

# Auth endpoints stricter limit
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=3600000

# ============================================================
# SECURITY
# ============================================================

# Helmet CSP (auto-configured)
# HELMET_CSP_ENABLED=true

# ============================================================
# OBSERVABILITY
# ============================================================

# Sentry DSN (error tracking)
SENTRY_DSN=

# Sentry environment
SENTRY_ENV=development

# Sentry traces sample rate (0-1)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry profiles sample rate (0-1)
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Log level (debug|info|warn|error)
LOG_LEVEL=info

# Log format (json|pretty)
LOG_FORMAT=pretty

# Metrics endpoint enabled
METRICS_ENABLED=true

# ============================================================
# TELEGRAM NOTIFICATIONS
# ============================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ============================================================
# S3 / OBJECT STORAGE (Beget Cloud, AWS S3, MinIO, etc.)
# ============================================================

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=false

# ============================================================
# FEATURE FLAGS
# ============================================================

# Legacy client compatibility is disabled because all supported clients use server-issued game attempts.
GAME_SAVE_LEGACY_COMPAT_ENABLED=false
# Server-issued game attempt lifetime and optional start delay.
GAME_ATTEMPT_TTL_SECONDS=900
GAME_ATTEMPT_NOT_BEFORE_MS=0

# Maintenance mode
MAINTENANCE_MODE=false

# WASM analytics fallback (default: true)
WASM_FALLBACK_ENABLED=true

# Opt-in Node/Prisma durable outbox for Rust shadow analytics. The Node runtime
# writes it atomically with a game save; Rust does not receive DB credentials.
ANALYTICS_OUTBOX_SHADOW_ENABLED=false

# Independently opt in to the Node-owned outbox worker. It currently persists
# TypeScript summaries only. Rust delivery remains disabled until Phase 3.
ANALYTICS_OUTBOX_DISPATCH_ENABLED=false

# Optional internal Rust sidecar shadow comparison. It is invoked only by the
# enabled Node worker, never owns a save or database, and does not receive IDs
# beyond the privacy-reviewed AnalyzeSession contract.
RUST_ANALYTICS_SIDECAR_ENABLED=false
RUST_ANALYTICS_SIDECAR_URL=http://127.0.0.1:3010
RUST_ANALYTICS_SIDECAR_TIMEOUT_MS=1000

# Deterministic shadow-only rollout percentage, 0-100. Start at 0, validate
# the internal sidecar with the parity runner, then use a time-bounded canary.
RUST_ANALYTICS_SIDECAR_ROLLOUT_PERCENT=0

# ============================================================
# DEVELOPMENT OVERRIDES
# ============================================================

# Override DATABASE_URL for local dev with Docker
# DATABASE_URL=postgresql://kognitika:kognitika@localhost:5432/kognitika?schema=public

# Skip Prisma generate in CI
# SKIP_PRISMA_GENERATE=false
