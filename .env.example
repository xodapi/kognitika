# Kognitika - Environment Variables
# Copy to .env and fill in values

# ============================================================
# REQUIRED - Application will fail to start without these
# ============================================================

# JWT Secret for authentication tokens (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Database connection (PostgreSQL)
# Format: ************************************/database?schema=public
DATABASE_URL=**********************************************/kognitika?schema=public

# Docker Compose database credentials (required by docker-compose.yml)
POSTGRES_USER=kognitika
POSTGRES_PASSWORD=replace-with-strong-random-password
POSTGRES_DB=kognitika

# ============================================================
# SERVER CONFIGURATION
# ============================================================

# Server port (default: 3006)
PORT=3006

# Node environment (development|production)
NODE_ENV=development

# Build identifier (auto-set in CI/CD)
# BUILD_HASH=
# GIT_COMMIT=

# ============================================================
# CORS CONFIGURATION
# ============================================================

# Comma-separated list of allowed origins
# Production: must be explicit (no wildcards)
# Development: can use wildcard with CORS_ALLOW_DEV_WILDCARD=true
CORS_ORIGIN=https://kognitika.ru,http://localhost:3006,http://127.0.0.1:3006

# Allow wildcard (*) in development only
# DANGEROUS in production - requires explicit opt-in
CORS_ALLOW_DEV_WILDCARD=false

# ============================================================
# RATE LIMITING
# ============================================================

# API rate limit window (ms)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window
RATE_LIMIT_MAX=100

# Auth endpoints stricter limit
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=3600000

# ============================================================
# SECURITY
# ============================================================

# Helmet CSP (auto-configured)
# HELMET_CSP_ENABLED=true

# ============================================================
# OBSERVABILITY
# ============================================================

# Sentry DSN (error tracking)
SENTRY_DSN=

# Sentry environment
SENTRY_ENV=development

# Sentry traces sample rate (0-1)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry profiles sample rate (0-1)
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Log level (debug|info|warn|error)
LOG_LEVEL=info

# Log format (json|pretty)
LOG_FORMAT=pretty

# Metrics endpoint enabled
METRICS_ENABLED=true

# ============================================================
# EMAIL (SMTP - Stalwart or other)
# ============================================================

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@example.com
SMTP_PASS=your-smtp-password

# Admin notification email
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Enable legacy email notifications (opt-in, default: false)
LEGACY_EMAIL_NOTIFICATIONS_ENABLED="false"

# Enable legacy email authentication (opt-in, default: false)
LEGACY_EMAIL_AUTH_ENABLED="false"

# ============================================================
# TELEGRAM NOTIFICATIONS
# ============================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ============================================================
# S3 / OBJECT STORAGE (Beget Cloud, AWS S3, MinIO, etc.)
# ============================================================

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=false

# ============================================================
# ADMIN NOTIFICATIONS
# ============================================================

ADMIN_NOTIFICATION_EMAIL=

# ============================================================
# FEATURE FLAGS
# ============================================================

# Temporary rollout compatibility. Set false after all clients send clientRunId.
GAME_SAVE_LEGACY_COMPAT_ENABLED=true

# Maintenance mode
MAINTENANCE_MODE=false

# WASM analytics fallback (default: true)
WASM_FALLBACK_ENABLED=true

# ============================================================
# DEVELOPMENT OVERRIDES
# ============================================================

# Override DATABASE_URL for local dev with Docker
# DATABASE_URL=postgresql://kognitika:kognitika@localhost:5432/kognitika?schema=public

# Skip Prisma generate in CI
# SKIP_PRISMA_GENERATE=false
